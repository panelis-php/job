{
  "name": "panelis-php/job",
  "description": "Monitor and manage queued jobs stored in the database",
  "license": "MIT",
  "keywords": [
    "panelis"
  ],
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "type": "library",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0",
    "panelis-php/activity": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Job\\": "src/",
      "Panelis\\Job\\Database\\Factories\\": "database/factories/",
      "Panelis\\Job\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Job\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1",
    "laravel/pint": "^1.31"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Job\\Providers\\JobServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Job\\Plugins\\JobPlugin"
      ]
    }
  }
}
